# Copiar a .env y completar con tus valores. Nunca commitear .env (ya está en .gitignore).

# API key de ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — usada para generar
# la voz (TTS) a partir del guion de texto, con timestamps por palabra para los captions.
ELEVENLABS_API_KEY=

# Voice ID de ElevenLabs a usar (por defecto usa una voz preestablecida si se omite).
# Ver voces disponibles: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Modelo de Claude Code CLI a usar para decidir el plan de edición (pacing, transiciones,
# captions). Si se omite, usa el default configurado en la CLI de Claude Code del host.
# CLAUDE_MODEL=claude-sonnet-5
