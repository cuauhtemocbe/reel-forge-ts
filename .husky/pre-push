#!/bin/sh

echo "🚀 Running pre-push validation..."

protected_branch='main'
current_branch=$(git rev-parse --abbrev-ref HEAD)

if echo "$current_branch" | grep -qE "^($protected_branch)$"; then
    echo "🛡️  Pushing to protected branch: $current_branch"

    if ! make validate; then
        echo "❌ Pre-push validation failed"
        exit 1
    fi

    echo "✅ Pre-push validation passed"
else
    echo "📝 Pushing to feature branch: $current_branch (basic checks only)"

    if ! pnpm run typecheck; then
        echo "❌ TypeScript type checking failed"
        exit 1
    fi

    echo "✅ Basic pre-push validation passed"
fi
